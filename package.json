{
  "name": "open-xmen",
  "version": "0.4.15",
  "description": "Cerebro/X-Men workflow for OpenCode: agent planning + deterministic TypeScript execution engine + Cyclops audit.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "open-xmen": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "dist/index.d.ts",
      "import": "dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate-assets": "bun scripts/generate-assets.ts",
    "build": "tsc -p tsconfig.json",
    "doctor": "node dist/cli.js doctor",
    "test": "bun test",
    "validate": "npm run build && npm run test && npm run verify:release",
    "prepare": "npm run build",
    "prepublishOnly": "npm run validate",
    "pack:check": "npm pack --dry-run",
    "verify:release": "bun scripts/verify-release-artifact.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.16.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
