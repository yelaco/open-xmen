{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./.opencode/plugins/open-xmen.ts"],
  "share": "disabled",
  "instructions": [
    "AGENTS.md",
    ".cerebro/cerebro-identity.md",
    ".cerebro/opencode/model-routing.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
  },
  "agent": {
    "cerebro": {
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "temperature": 0.2,
      "steps": 80,
      "description": "Cerebro team lead for preserved Cerebro commands and OpenCode-native orchestration.",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask"
      }
    }
  }
}
